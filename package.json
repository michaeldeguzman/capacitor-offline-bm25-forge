{
  "name": "capacitor-offline-bm25",
  "version": "0.1.0-beta.2",
  "description": "On-device BM25 keyword search for Capacitor, with a native inverted index (iOS and Android)",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "CapacitorOfflineBm25.podspec"
  ],
  "author": "Michael de Guzman",
  "license": "MIT",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "bm25",
    "keyword-search",
    "full-text-search",
    "ios",
    "android",
    "ondevice",
    "outsystems",
    "odc"
  ],
  "scripts": {
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin -destination generic/platform=iOS && cd ..",
    "test:ios": "cd ios && pod install && xcodebuild test -workspace Plugin.xcworkspace -scheme PluginTests -destination 'platform=iOS Simulator,name=iPhone 17' && cd ..",
    "build": "npm run clean && tsc && rollup -c rollup.config.js",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.32.0",
    "typescript": "~4.1.5"
  },
  "peerDependencies": {
    "@capacitor/core": ">=5.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaeldeguzman/capacitor-offline-bm25-forge.git"
  },
  "bugs": {
    "url": "https://github.com/michaeldeguzman/capacitor-offline-bm25-forge/issues"
  },
  "homepage": "https://github.com/michaeldeguzman/capacitor-offline-bm25-forge#readme"
}
